# SMTP server that sends the applications, e.g. smtp.gmail.com with an app password
NUXT_MAIL_HOST=
NUXT_MAIL_PORT=465
NUXT_MAIL_SECURE=true
NUXT_MAIL_USER=
NUXT_MAIL_PASSWORD=
# Sender address, defaults to NUXT_MAIL_USER
NUXT_MAIL_FROM=
# Recipient of the applications, an @mh-freiburg.de address
NUXT_MAIL_TO=

# Random secret for signing ALTCHA challenges, generated by docker/update.sh if missing
NUXT_ALTCHA_HMAC_KEY=
